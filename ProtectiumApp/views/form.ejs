<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title><%= producto ? "Editar producto" : "Nuevo producto" %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/form.css">
    <link rel="icon" href="/favicon1.jpg" type="image/png">
</head>
<body>

    <header>
        <nav class="nav">
            <div class="contenedor">
                <div class="contenedor-logo">                    
                    <button onclick="volverAInicio()">
                        <img src="/favicon2.jpg" alt="logoEmpresa">
                    </button> 
                    <div class="texto-logo">
                        <span class="titulo-app">Protectium App</span>
                        <span class="subtitulo-app">Licencias originales, seguridad garantizada</span>
                    </div>
                </div>                 
                <ul class="menu">
                    <li>
                        <a href="/admin/dashboard">Productos</a>
                    </li>
                    <li>
                        <a href="/admin/productos/crear" >
                            + Nuevo
                        </a>
                    </li>
                    <li>
                        <a href="/auth/logout" >
                             Salir
                        </a>       
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <main>
        <div class="container mt-5">
            <h2 class="mb-4 text-center">
                <%= producto ? "Editar producto" : "Crear producto" %>
            </h2>
            <form id="form" action="<%= producto ? '/admin/productos/editar/' + producto.id : '/admin/productos/crear' %>" method="POST">
                <!-- NOMBRE -->
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input type="text"
                        name="nombre"
                        class="form-control"
                        value="<%= producto ? producto.nombre : '' %>"
                        minlength="3"
                        maxlength="100"
                        required>
                </div>
                
                <!-- DESCRIPCION -->
                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <textarea
                        name="descripcion"
                        class="form-control"
                        rows="4"
                        minlength="10"
                        maxlength="500"
                        required><%= producto ? producto.descripcion : '' %></textarea>
                </div>
                <!-- PRECIO -->
                <div class="mb-3">
                    <label class="form-label">Precio</label>
                    <input type="number"
                        name="precio"
                        class="form-control"
                        value="<%= producto ? producto.precio : '' %>"
                        min="0"
                        required>
                </div>
                <!-- STOCK -->
                <div class="mb-3">
                    <label class="form-label">Stock</label>
                    <input type="number"
                        name="stock"
                        class="form-control"
                        value="<%= producto ? producto.stock : '' %>"
                        min="0"
                        step="1"
                        required>
                </div>
                <!-- IMAGEN -->
                <div class="mb-3">
                    <label class="form-label">Imagen (URL)</label>
                    <input type="text"
                        name="imagen"
                        class="form-control"
                        value="<%= producto ? producto.imagen : '' %>">
                </div>
                <div id="avisoError" class=" alert alert-dangertext-center">
                    
                </div>
                <% if (errores && errores.length) { %>
                    <% errores.forEach(error => { %>
                        <div class="alert alert-danger">
                            <%= error %>
                        </div>
                    <% }) %>
                <% } %>
                
                <!-- BOTONES -->
                <div class="d-flex gap-2 mb-3">
                    <button type="submit" class="btn btn-success">
                        <%= producto ? "Actualizar" : "Crear" %>
                    </button>
                    <a href="/admin/dashboard" class="btn btn-secondary">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </main>

    <script src="/js/form.js"></script>
</body>
</html>
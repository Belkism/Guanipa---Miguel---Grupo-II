<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Protectium App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="icon" href="/favicon1.jpg" type="image/png">
</head>
<body>

    <header>
        <nav class="nav">
            <div class="contenedor">
                <div class="contenedor-logo">
                    
                    <button onclick="volverAInicio()">
                        <img src="/favicon2.jpg" alt="logoEmpresa">
                    </button> 
                       
                    <div class="texto-logo">
                        <span class="titulo-app">Protectium App</span>
                        <span class="subtitulo-app">Licencias originales, seguridad garantizada</span>
                    </div>
                </div>
                  
                <ul class="menu">
                    <li>
                        <a href="/admin/ventas">Ventas</a>
                    </li>

                    <li>
                        <a href="/admin/productos/crear" >
                            + Nuevo
                        </a>
                    </li>

                    <li>
                        <a href="/auth/logout" >
                             Salir
                        </a>
        
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    
    <main class="container my-5">
         <div class="mb-4">
            <h1 class="fw-bold text-center">Gestión de Inventario</h1>
            
        </div>
        <!-- ================= SEGURIDAD ================= --> 
        <section class="categoria-section mb-5">
            <h2 class="mb-4 text-warning">Seguridad</h2>
            <div id="contenedorSeguridad">
                <% productos.forEach(producto => { %>
                    <% if (producto.categoria_id === 1 && Number(producto.activo) === 1) { %>
                        <div class="card mb-3 shadow-sm">
                            <div class="card-body">
                                <div class="row g-0 align-items-center">
                                    <!-- IMAGEN -->
                                    <div class="col-md-2 text-center p-2">
                                        <img src="<%= producto.imagen %>"
                                            class="img-fluid rounded"
                                            alt="Producto">
                                    </div>
                                    <!-- INFO + ACCIONES -->
                                    <div class="col-md-10 d-flex justify-content-between align-items-center">
                                        <div>
                                            <h5 class="mb-1">
                                                <%= producto.nombre %>
                                            </h5>
                                            <small class="text-muted">
                                                $ <%= producto.precio %>
                                            </small>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a href="/admin/productos/editar/<%= producto.id %>"
                                            class="btn btn-warning btn-sm">
                                                Editar
                                            </a>
                                            
                                            <button class="btn btn-danger btn-sm btn-eliminar"
                                            data-id="<%= producto.id %>">
                                                Eliminar
                                            </button>
                                            
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                <% }) %>
            </div>
        </section>


        <!-- ================= PRODUCTIVIDAD ================= -->
        <section class="categoria-section mb-5">
            <h2 class="mb-4 text-warning">Productividad</h2>
            <div id="contenedorProductividad">
                <% productos.forEach(producto => { %>
                    <% if (producto.categoria_id === 2 && Number(producto.activo) === 1) { %>
                        <div class="card mb-3 shadow-sm">
                            <div class="card-body">
                                <div class="row g-0 align-items-center">
                                    <!-- IMAGEN -->
                                    <div class="col-md-2 text-center p-2">
                                        <img src="<%= producto.imagen %>"
                                            class="img-fluid rounded"
                                            alt="Producto">
                                    </div>
                                    <!-- INFO + ACCIONES -->
                                    <div class="col-md-10 d-flex justify-content-between align-items-center">
                                        <div>
                                            <h5 class="mb-1">
                                                <%= producto.nombre %>
                                            </h5>
                                            <small class="text-muted">
                                                $ <%= producto.precio %>
                                            </small>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a href="/admin/productos/editar/<%= producto.id %>"
                                            class="btn btn-warning btn-sm">
                                                Editar
                                            </a>
                                            
                                            <button class="btn btn-danger btn-sm btn-eliminar"
                                            data-id="<%= producto.id %>">
                                                Eliminar
                                            </button>
                                            
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                <% }) %>
            </div>
        </section>

        <!-- ================= INACTIVOS ================= -->
        <section class="categoria-section mb-5">
            <h2 class="mb-4 text-secondary">Productos dados de baja</h2>
            <div id="contenedorInactivos">
                <% const inactivos = productos.filter(producto => Number(producto.activo) !== 1); %>

                <% if (inactivos.length === 0) { %>
                    <p class="text-muted">No hay productos dados de baja.</p>
                <% } %>

                <% inactivos.forEach(producto => { %>
                    <div class="card mb-3 shadow-sm border-secondary">
                        <div class="card-body">
                            <div class="row g-0 align-items-center">
                                <div class="col-md-2 text-center p-2">
                                    <img src="<%= producto.imagen %>"
                                        class="img-fluid rounded"
                                        alt="Producto inactivo">
                                </div>

                                <div class="col-md-10 d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-1 text-secondary">
                                            <%= producto.nombre %>
                                        </h5>
                                        <small class="text-muted">
                                            $ <%= producto.precio %>
                                        </small>
                                    </div>

                                    <button class="btn btn-success btn-sm btn-reactivar"
                                        data-id="<%= producto.id %>">
                                        Reactivar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>
            
    </main>
    
    <script src="/js/dashboard.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>   
</body>
</html>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Administrador</title>
    <link rel="icon" href="/favicon1.jpg" type="image/png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>

    <div class="container vh-100 d-flex justify-content-center align-items-start pt-5">
        <div class="card shadow-lg border-0" style="width: 400px;">           
            <div class="card-body p-4">
                <div class="text-center mb-3">
                    <a href="/">
                        <img
                            src="/favicon2.jpg"
                            alt="Protectium"
                            class="img-fluid"
                            style="max-width: 90px;">
                    </a>
                </div>
                <h3 class="text-center mb-1">
                    PROTECTIUM APP
                </h3>
                <p class="text-center text-muted mb-4">
                    Panel de Administración
                </p>

                <% if(typeof error !== 'undefined'){ %>
                    <div class="alert alert-danger">
                        <%= error %>
                    </div>
                <% } %>

                <form action="/auth/login" method="POST">
                    <div class="mb-3">
                        <label class="form-label">
                            Correo electrónico
                        </label>
                        <input
                            type="email"
                            name="correo"
                            id="email"
                            class="form-control"
                            placeholder="Ingrese su correo"
                            required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">
                            Contraseña
                        </label>
                        <input
                            type="password"
                            name="contrasena"
                            id="password"
                            class="form-control"
                            placeholder="Ingrese su contraseña"
                            autocomplete="off"
                            required>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button
                            type="submit"
                            class="btn btn-primary">
                            Ingresar
                        </button>
                        <button
                            type="button"
                            id="btnAccesoRapido"
                            class="btn btn-outline-secondary">
                            Acceso rápido
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <footer>
        <small>
            TP-Belkis Guanipa - Lujan Miguel
        </small>
    </footer>

    <script src="/js/login.js"></script>

</body>
</html>